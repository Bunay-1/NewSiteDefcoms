# Database Configuration
# Prisma supports PostgreSQL, MySQL, SQLite, SQL Server, MongoDB, and CockroachDB.
DATABASE_URL="file:./dev.db"

# NextAuth Configuration
# Secret key for token encryption (use a strong random string in production)
AUTH_SECRET="your-secret-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# SMTP Configuration (For email notifications)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="notifications@defcoms.eu"
SMTP_PASS="YourSecureSMTPPassword"
SMTP_FROM="DefComs <notifications@defcoms.eu>"
